{
  // Run with "Tasks: Run Task". The "Start: ..." tasks bring up a whole stack.
  // The collaboration server also needs MongoDB running (see CONTRIBUTING.md).
  "version": "2.0.0",
  "tasks": [
    // Setup
    {
      "label": "yarn install",
      "type": "shell",
      "command": "yarn",
      "detail": "Install dependencies",
      "problemMatcher": [],
    },
    {
      "label": "jbrowse: install version",
      "type": "shell",
      // Installs into .jbrowse, or switches the version already there. Switching
      // replaces JBrowse's own files and keeps anything else in .jbrowse.
      "command": "v='${input:jbrowseVersion}'; case \"$v\" in latest) f='' ;; nightly) f='--nightly' ;; branch:*) f=\"--branch ${v#branch:}\" ;; *) f=\"--tag $v\" ;; esac; if [ -f .jbrowse/manifest.json ]; then yarn jbrowse upgrade .jbrowse --clean $f; else yarn jbrowse create .jbrowse $f; fi && echo \"Installed JBrowse $(cat .jbrowse/version.txt)\"",
      "options": { "cwd": "${workspaceFolder}/packages/jbrowse-plugin-apollo" },
      "detail": "Install or switch the JBrowse version in .jbrowse (served by \"jbrowse: server\")",
      "problemMatcher": [],
    },
    {
      "label": "jbrowse: list versions",
      "type": "shell",
      "command": "yarn jbrowse create --listVersions",
      "options": { "cwd": "${workspaceFolder}/packages/jbrowse-plugin-apollo" },
      "detail": "List the JBrowse release tags that can be installed",
      "problemMatcher": [],
    },

    // Individual processes
    {
      "label": "shared: watch",
      "type": "npm",
      "script": "start",
      "path": "packages/apollo-shared",
      "detail": "Build @apollo-annotation/shared in watch mode",
      "isBackground": true,
      // Signals when the initial build is done, so dependent tasks wait for it
      "problemMatcher": "$tsc-watch",
      "presentation": { "group": "apollo" },
    },
    {
      "label": "server: dev",
      "type": "shell",
      "command": "yarn start:nest --watch",
      "options": {
        "cwd": "${workspaceFolder}/packages/apollo-collaboration-server",
      },
      "detail": "Collaboration server on :3999 using its .development.env",
      "dependsOn": ["shared: watch"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "apollo" },
    },
    {
      "label": "server: e2e",
      "type": "shell",
      "command": "yarn start:nest --watch",
      "options": {
        "cwd": "${workspaceFolder}/packages/apollo-collaboration-server",
        // Keep in sync with the "cypress:start" script
        "env": {
          "GUEST_USER_ROLE": "admin",
          "MONGODB_URI": "mongodb://localhost:27017/apolloTestDb?directConnection=true",
          "LOG_LEVELS": "error,warn",
        },
      },
      "detail": "Collaboration server on :3999 for Cypress (apolloTestDb, guest is admin)",
      "dependsOn": ["shared: watch"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "apollo" },
    },
    {
      "label": "server: CLI tests",
      "type": "shell",
      "command": "yarn start:nest --watch",
      "options": {
        "cwd": "${workspaceFolder}/packages/apollo-collaboration-server",
        // Keep in sync with the "test:cli:start" script
        "env": {
          "GUEST_USER_ROLE": "readOnly",
          "ALLOW_ROOT_USER": "true",
          "ROOT_USER_PASSWORD": "pass",
          "MONGODB_URI": "mongodb://localhost:27017/apolloTestCliDb?directConnection=true",
          "LOG_LEVELS": "error,warn",
        },
      },
      "detail": "Collaboration server on :3999 for CLI tests (apolloTestCliDb, root user enabled)",
      "dependsOn": ["shared: watch"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "apollo" },
    },
    {
      "label": "test data server",
      "type": "shell",
      "command": "yarn serve --no-request-logging --listen 3131 --no-port-switching test/data/",
      "options": {
        "cwd": "${workspaceFolder}/packages/apollo-collaboration-server",
      },
      "detail": "Serve collaboration server test/data on :3131 (used by e2e and CLI tests)",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "apollo" },
    },
    {
      "label": "plugin: watch",
      "type": "npm",
      "script": "start:watch",
      "path": "packages/jbrowse-plugin-apollo",
      "detail": "Build the JBrowse plugin in watch mode",
      "dependsOn": ["shared: watch"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "plugin" },
    },
    {
      "label": "plugin: server",
      "type": "npm",
      "script": "start:server",
      "path": "packages/jbrowse-plugin-apollo",
      "detail": "Serve the built plugin on :9000",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "plugin" },
    },
    {
      "label": "jbrowse: server",
      "type": "npm",
      "script": "browse",
      "path": "packages/jbrowse-plugin-apollo",
      "detail": "Serve JBrowse from .jbrowse on :8999 (run \"jbrowse: install version\" first)",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "group": "plugin" },
    },
    {
      "label": "cypress: open",
      "type": "shell",
      "command": "yarn cypress open",
      "options": { "cwd": "${workspaceFolder}/packages/jbrowse-plugin-apollo" },
      "detail": "Open the Cypress runner against :8999 (start \"Start: e2e\" first)",
      "problemMatcher": [],
    },

    // Stacks
    {
      "label": "Start: dev",
      "detail": "Shared, collaboration server, and plugin (JBrowse runs separately)",
      "dependsOn": ["server: dev", "plugin: watch", "plugin: server"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
    },
    {
      "label": "Start: e2e",
      "detail": "Everything the Cypress tests need",
      "dependsOn": [
        "server: e2e",
        "test data server",
        "plugin: watch",
        "plugin: server",
        "jbrowse: server",
      ],
      "problemMatcher": [],
    },
    {
      "label": "Start: CLI tests",
      "detail": "Everything the apollo-cli tests need",
      "dependsOn": ["server: CLI tests", "test data server"],
      "problemMatcher": [],
    },
  ],
  "inputs": [
    {
      "id": "jbrowseVersion",
      "type": "promptString",
      "description": "JBrowse version: a tag like v4.3.0, \"latest\", \"nightly\", or \"branch:<name>\"",
      "default": "latest",
    },
  ],
}
