{
  "name": "@apollo-annotation/plugin-example",
  "version": "0.0.0",
  "private": true,
  "description": "An example Apollo plugin, with a JBrowse (client) half and a collaboration server half",
  "repository": {
    "type": "git",
    "url": "https://github.com/GMOD/Apollo3.git",
    "directory": "packages/apollo-plugin-example"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js"
  },
  "scripts": {
    "build": "tsc --build && yarn build:client && yarn build:server",
    "build:client": "JB_NPM=false JB_UMD=true rolldown --config ../jbrowse-plugin-apollo/rolldown/rolldown.config.mjs",
    "build:server": "rolldown --config rolldown.server.config.mjs",
    "test": "glob -c \"tsx --test --test-reporter spec \" \"src/**/*.test.ts\"",
    "test:ci": "glob -c \"tsx --test --test-reporter spec \" \"src/**/*.test.ts\""
  },
  "config": {
    "jbrowse": {
      "plugin": {
        "name": "ApolloExample"
      }
    }
  },
  "dependencies": {
    "@apollo-annotation/common": "workspace:^"
  },
  "devDependencies": {
    "@apollo-annotation/mst": "workspace:^",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@jbrowse/core": "^5.0.0-beta.10",
    "@jbrowse/mobx-state-tree": "^6.5.2",
    "@mui/material": "^9.4.0",
    "@mui/system": "^9.4.0",
    "@types/express": "^4.17.13",
    "@types/node": "^24.10.9",
    "@types/react": "^18.3.4",
    "glob": "^11.0.0",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.2",
    "mongoose": "^9.9.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.0",
    "rxjs": "^7.4.0",
    "tss-react": "^4.9.21",
    "tsx": "^4.6.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@apollo-annotation/mst": "workspace:^",
    "@jbrowse/core": "^5.0.0-beta.10"
  }
}
