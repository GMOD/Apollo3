{
  "assemblies": [
    {
      "name": "volvox",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "volvox_refseq",
        "adapter": {
          "type": "UnindexedFastaAdapter",
          "uri": "http://localhost:9000/test_data/gene.fa"
        }
      }
    }
  ],
  "configuration": {
    "ApolloPlugin": {
      "ontologies": [
        {
          "name": "Sequence Ontology",
          "version": "unversioned",
          "source": {
            "uri": "http://localhost:9000/test_data/so-2024-11-18.json",
            "locationType": "UriLocation"
          }
        }
      ]
    }
  },
  "defaultSession": {
    "name": "Apollo",
    "views": [{ "type": "LinearGenomeView" }]
  },
  "plugins": [
    {
      "name": "Apollo",
      "url": "http://localhost:9000/dist/jbrowse-plugin-apollo.umd.development.js"
    }
  ]
}
