# Copy this file to .development.local.env (which is gitignored) and fill in any
# values you want. Anything set here overrides .development.env.
# See CONTRIBUTING.md for how to get your own Google and Microsoft credentials.
# Leave a variable commented out if you don't have a value for it.

# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# Any other OpenID Connect provider, see the "Login management" docs page
# OIDC_PROVIDERS=keycloak
# OIDC_KEYCLOAK_ISSUER=
# OIDC_KEYCLOAK_CLIENT_ID=
# OIDC_KEYCLOAK_CLIENT_SECRET=
