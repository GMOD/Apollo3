{
  "name": "@apollo-annotation/website",
  "private": true,
  "scripts": {
    "build": "yarn gen-api-docs && docusaurus build",
    "clear": "docusaurus clear",
    "deploy": "docusaurus deploy",
    "gen-api-docs": "docusaurus clean-api-docs all && docusaurus gen-api-docs all",
    "serve": "docusaurus serve",
    "start": "yarn gen-api-docs && docusaurus start --port 3113",
    "swizzle": "docusaurus swizzle",
    "typecheck": "yarn gen-api-docs && tsc",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/plugin-content-docs": "3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@docusaurus/remark-plugin-npm2yarn": "^3.10.1",
    "@docusaurus/theme-common": "3.10.1",
    "@docusaurus/utils": "3.10.1",
    "@docusaurus/utils-validation": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^1.1.1",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-plugin-sass": "^0.2.6",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.89.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/theme-classic": "^3.10.1",
    "@docusaurus/tsconfig": "^3.10.1",
    "@docusaurus/types": "^3.10.1",
    "@types/node": "^24.10.9",
    "@types/react": "^18.3.4",
    "typescript": "^6.0.3"
  }
}
