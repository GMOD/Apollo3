{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // baseUrl is deprecated in TypeScript 6, so unset the one inherited from
    // @docusaurus/tsconfig and declare paths relative to this file instead
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"],
    },
    "strictNullChecks": true,
  },
}
